# Copy to .env for Docker Compose. Local `manage.py runserver` uses SQLite unless POSTGRES_DB is exported.
DEBUG=1
SECRET_KEY=replace-me
ALLOWED_HOSTS=*
# CSRF_TRUSTED_ORIGINS=https://shop.example.com
POSTGRES_DB=commercelab
POSTGRES_USER=commercelab
POSTGRES_PASSWORD=commercelab
POSTGRES_HOST=db
POSTGRES_PORT=5432
STOREFRONT_PAGE_SIZE=12
STORE_NAME=Sondermark Coffee Roasters
STORE_SHORT_NAME=Sondermark
STORE_CURRENCY=€
# Payments & jobs
PAYMENT_GATEWAY=simulated
PAYMENT_WEBHOOK_SECRET=change-me-for-webhooks
ORDER_PAYMENT_TIMEOUT_HOURS=24
CART_RETENTION_DAYS=30
SITE_URL=http://localhost:8000
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   (default: console)
# CELERY_BROKER_URL=redis://localhost:6379/0                  (unset = tasks run inline)
# MEDIA_ROOT=/app/media
